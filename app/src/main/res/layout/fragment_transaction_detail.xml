<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/operator_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Orange Money" />

                <TextView
                    android:id="@+id/amount_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="100 000 Ar" />

                <TextView
                    android:id="@+id/type_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    tools:text="Reçu" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/DetailLabel"
                    android:text="@string/transaction_detail_phone" />
                <TextView
                    android:id="@+id/phone_text"
                    style="@style/DetailValue"
                    tools:text="+261 32 12 34 56" />

                <TextView
                    style="@style/DetailLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/transaction_detail_date" />
                <TextView
                    android:id="@+id/date_text"
                    style="@style/DetailValue"
                    tools:text="10/09/2026 14:32" />

                <LinearLayout
                    android:id="@+id/reference_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/DetailLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/transaction_detail_reference" />
                    <TextView
                        android:id="@+id/reference_text"
                        style="@style/DetailValue"
                        tools:text="ABC123" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bonus_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/DetailLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/transaction_detail_bonus" />
                    <TextView
                        android:id="@+id/bonus_amount_text"
                        style="@style/DetailValue"
                        android:textColor="@color/orange_money"
                        tools:text="1 500 Ar" />
                </LinearLayout>

                <TextView
                    style="@style/DetailLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/transaction_detail_profit" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/profit_text"
                        style="@style/DetailValue"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/profit_green"
                        tools:text="3 000 Ar" />

                    <ImageButton
                        android:id="@+id/edit_profit_button"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/transaction_detail_edit_profit"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/transaction_detail_delete"
            android:textColor="@color/loss_red"
            app:strokeColor="@color/loss_red" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
